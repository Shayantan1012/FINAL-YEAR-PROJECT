NODE_ENV=development
HOST=0.0.0.0
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/harvest?replicaSet=rs0
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Optional HTTPS reverse-geocoding endpoint for selected delivery and farm pins.
REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
SESSION_DAYS=7
EXPOSE_DEV_OTP=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Harvest <no-reply@example.com>
# Set only when running npm run create-admin; remove after provisioning.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
